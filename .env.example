# Environment variables for summary-finetune

# Anthropic API key for synthetic data generation
# Get your key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here

# OpenAI API key for synthetic data generation
# Get your key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_api_key_here

# Weights & Biases (optional, for experiment tracking)
# WANDB_API_KEY=your_wandb_key
# WANDB_PROJECT=qwen3-json-finetuning
# WANDB_ENTITY=your_username

# HuggingFace (optional, for model downloads and uploads)
# HF_TOKEN=your_hf_token

# vLLM Server Configuration
VLLM_HOST=0.0.0.0
VLLM_PORT=8000

# FastAPI Server Configuration
API_HOST=0.0.0.0
API_PORT=8080

# Training Configuration
# CUDA_VISIBLE_DEVICES=0  # GPU device(s) to use

# UV Configuration
# Make uv respect active virtual environment by default
UV_PROJECT_ENVIRONMENT=.venv
